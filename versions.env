# Upstream versions and their source hashes for the self-built container
# engine.
#
# These versions and not the distribution's: trixie ships podman 5.4.2, crun
# 1.21, netavark 1.14. Pinning here means the engine's version is a decision in
# this repository rather than a consequence of which Debian release the base
# happens to be. Space is a side effect, not the reason.

# This file is the upgrade interface. Bump a tag, bump its hash, run the image
# chain, read the verifier. Same shape as boards/cx3576/board.env, and for
# the same reason: "which engine is on this device" has to be answerable from
# the tree rather than from a build log. The hash is of the git tree at the
# tag, taken by `git archive` and piped to sha256sum inside the build, so it
# covers the source we actually compile. A tag can be moved; a hash cannot.

# To bump one: change the tag, set its hash to the literal string `PENDING`,
# and run `make podman`. The build prints the hash it computed and fails; paste
# it in and run again. There is no environment variable that softens that into
# a warning: recording a hash is an act rather than a copy from an upstream
# page nobody re-checked.

# podman is pinned to the 5.x line, NOT the newest tag: upstream maintains both
# 5.x and 6.x, and 5.8.6 is the line this build was brought up on. Moving to
# 6.x is this file's job and costs two lines -- set the tag, set the hash to
# PENDING, run `make podman`, paste the hash it prints. Every other component
# below is at its newest upstream release.
PODMAN_VERSION=v5.8.6
PODMAN_SHA256=c2902305ef17a1207ee8c90e645cbbff8ffdf4a2dd493166cdd9cc8b04ef1f8c

CRUN_VERSION=1.29.1
CRUN_SHA256=d5f2f27ea25554ad28c4163749cd3060f39ba48461b5dc6e80cf676b53ba5515

CONMON_VERSION=v2.2.1
CONMON_SHA256=d3e602a1ae17dc73d1ee1b099a7510202878344f4546612547a86daee67be079

# netavark and aardvark-dns move together: netavark invokes aardvark-dns and
# writes its configuration, so a version skew between them is a DNS failure
# inside containers rather than a build failure here.
#
# The 2.x pair needs a glibc target: aardvark-dns 2.x calls libc::close_range,
# and the libc crate defines that symbol for gnu and NOT for musl (1 occurrence
# in gnu/mod.rs, 0 in musl/mod.rs). This build targets glibc, so the constraint
# does not bind -- a musl build would have to go back to the 1.17 pair.
NETAVARK_VERSION=v2.1.0
NETAVARK_SHA256=e6abbd7206bbdb431a7d6b186e8dad1d37e77a4522fe8104b6ce1785ea26bd8c

AARDVARK_VERSION=v2.1.0
AARDVARK_SHA256=c07b42ded1ad43d722143791fb0323f91bad3259d13774120e54321d018b760e

# catatonit's newest release is v0.2.1, dated 2024-12-14. That is the cadence
# of a few-hundred-KB container init rather than evidence of abandonment, but
# it is the slowest-moving upstream this build carries and so the one most
# worth re-checking.
CATATONIT_VERSION=v0.2.1
CATATONIT_SHA256=2c43bfd6a3466dc6d23355956f6f8dc4dba8c75706ee9eb802eaaaa62d58d7f5
