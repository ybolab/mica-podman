# FIXTURE, not a pin. The six *_VERSION assignments of
# versions.env with one edited, so tests/podman-pins-test.sh
# can drive check-pins.sh's red directions without ever writing to the real
# upgrade interface. The *_SHA256 lines are dropped on purpose: check-pins.sh
# never reads a hash, and a hash sitting here next to a tag it does not belong
# to would be a wrong pin written down.
PODMAN_VERSION=v5.8.6
CRUN_VERSION=1.28
CONMON_VERSION=v2.2.1
NETAVARK_VERSION=v2.1.0
AARDVARK_VERSION=v2.1.0
CATATONIT_VERSION=v0.2.1
